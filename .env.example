# Zaatra Environment Configuration Template
# Copy this file to .env and fill in your actual credentials

# Backend API Endpoints
# Used for Chrome / Web browser testing:
WEB_BASE_URL=http://localhost:5000/api
# Used for Android emulator / physical devices / tunnels:
BASE_URL=http://localhost:5000/api

# Google Maps Places & Directions API Key
GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY

# Razorpay Payment Gateway Key ID
RAZORPAY_KEY_ID=YOUR_RAZORPAY_KEY_ID

# Default Driver Credentials
DEFAULT_DRIVER_PASSWORD=YOUR_DEFAULT_DRIVER_PASSWORD
